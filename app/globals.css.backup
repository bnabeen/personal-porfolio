@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Public+Sans:wght@400;500;600&display=swap');

:root {
  --bg: #FFFFFF;
  --ink: #111111;
  --muted: #666666;
  --line: #E5E5E5;
  --soft: #FFFFFF;
  --blue: #111111;
  --blue-hover: #333333;
  --green: #111111;
  --card: #FFFFFF;
  --card-ink: #111111;
  --card-border: #E5E5E5;
  --header-bg: rgba(255, 255, 255, 0.95);
  --pill-bg: #111111;
  --pill-ink: #FFFFFF;
  --badge-bg: #F5F5F5;
  --badge-ink: #111111;
}

[data-theme="dark"] {
  --bg: #0A0A0A;
  --ink: #F0F0F0;
  --muted: #888888;
  --line: #222222;
  --soft: #0A0A0A;
  --blue: #F0F0F0;
  --blue-hover: #CCCCCC;
  --green: #F0F0F0;
  --card: #0A0A0A;
  --card-ink: #F0F0F0;
  --card-border: #222222;
  --header-bg: rgba(10, 10, 10, 0.95);
  --pill-bg: #F0F0F0;
  --pill-ink: #0A0A0A;
  --badge-bg: #1A1A1A;
  --badge-ink: #F0F0F0;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0A0A0A;
    --ink: #F0F0F0;
    --muted: #888888;
    --line: #222222;
    --soft: #0A0A0A;
    --blue: #F0F0F0;
    --blue-hover: #CCCCCC;
    --green: #F0F0F0;
    --card: #0A0A0A;
    --card-ink: #F0F0F0;
    --card-border: #222222;
    --header-bg: rgba(10, 10, 10, 0.95);
    --pill-bg: #F0F0F0;
    --pill-ink: #0A0A0A;
    --badge-bg: #1A1A1A;
    --badge-ink: #F0F0F0;
  }
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background-color: var(--bg);
  color: var(--ink);
  font-family: "Public Sans", system-ui, -apple-system, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition: background-color 0.3s ease, color 0.3s ease;
}

h1, h2, h3, h4, h5, h6, .display-font {
  font-family: "Inter Tight", system-ui, -apple-system, sans-serif;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--ink);
}

a {
  color: inherit;
  text-decoration: none;
  transition: opacity 0.2s ease, color 0.2s ease;
}

a:hover {
  opacity: 0.88;
}

:focus-visible {
  outline: 3px solid var(--blue);
  outline-offset: 3px;
}

.wrap {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 32px;
}

/* Glass Header */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--header-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  transition: background-color 0.3s ease, border-color 0.3s ease;
}

nav.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84px;
  gap: 24px;
}

.logo {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo-dot {
  width: 10px;
  height: 10px;
  background-color: var(--blue);
  border-radius: 50%;
  display: inline-block;
}

.menu-links {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
}

.menu-links a {
  font-size: 15px;
  font-weight: 500;
  opacity: 0.85;
  padding: 6px 0;
  position: relative;
}

.menu-links a:hover {
  opacity: 1;
}

.menu-links a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: var(--blue);
  transition: width 0.25s ease;
}

.menu-links a:hover::after {
  width: 100%;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.theme-toggle {
  background: var(--soft);
  border: 1px solid var(--line);
  color: var(--ink);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.theme-toggle:hover {
  transform: scale(1.05);
  border-color: var(--blue);
}

.btn-contact {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: var(--ink);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  padding: 8px 0;
  border: none;
  border-bottom: 1px solid var(--ink);
  transition: opacity 0.2s ease;
  cursor: pointer;
}

.btn-contact:hover {
  opacity: 0.7;
}

.burger-btn {
  display: none;
  background: var(--soft);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 10px;
  color: var(--ink);
  cursor: pointer;
}

/* Sections */
section {
  padding: 96px 0;
  border-top: 1px solid var(--line);
}

section h2 {
  font-size: clamp(32px, 4.2vw, 52px);
  margin-bottom: 14px;
}

section p.sub {
  color: var(--muted);
  max-width: 42em;
  font-size: 18px;
  margin: 0 0 48px;
}

/* Cards & Grids */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.grid.two {
  grid-template-columns: repeat(2, 1fr);
}

.card {
  background: transparent;
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: border-color 0.25s ease;
}

.card:hover {
  border-color: var(--ink);
}

.card-arrow {
  display: inline-block;
  transition: transform 0.3s ease;
}

.card:hover .card-arrow {
  transform: translate(3px, -3px);
}

.chip {
  display: inline-block;
  background: transparent;
  color: var(--muted);
  border: 1px solid var(--line);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 13px;
  font-family: "Public Sans", sans-serif;
}

.card h3 {
  font-size: 24px;
  margin-bottom: 12px;
}

.card p {
  color: var(--muted);
  font-size: 16px;
  line-height: 1.6;
}

.card .meta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 24px;
  font-size: 14px;
  color: var(--blue);
  font-weight: 600;
}

/* Pills & Badges */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: var(--ink);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  padding: 8px 0;
  border: none;
  border-bottom: 1px solid var(--ink);
  transition: opacity 0.2s ease;
  cursor: pointer;
}

.pill:hover {
  opacity: 0.7;
}

.pill i {
  font-style: normal;
}

.badge {
  display: inline-block;
  background: transparent;
  color: var(--ink);
  border: 1px solid var(--line);
  padding: 4px 14px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin-bottom: 12px;
}

/* Modal Overlay */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 24px;
}

.modal-content {
  background: var(--bg);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 4px;
  max-width: 800px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 48px;
  position: relative;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.3);
}

.modal-close {
  position: absolute;
  top: 24px;
  right: 24px;
  background: var(--soft);
  border: 1px solid var(--line);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  color: var(--ink);
  cursor: pointer;
}

/* Responsive Mobile Navigation */
@media (max-width: 900px) {
  nav.navbar {
    height: 72px;
  }
  
  .desktop-only {
    display: none !important;
  }

  .mobile-only {
    display: flex !important;
  }

  .grid, .grid.two {
    grid-template-columns: 1fr;
  }
  
  .form-grid-2 {
    grid-template-columns: 1fr !important;
  }

  .sidebar-layout {
    grid-template-columns: 1fr;
    gap: 64px;
  }

  .wrap {
    padding: 0 20px;
  }

  section {
    padding: 64px 0;
  }
  
  .page-container {
    padding-top: 32px !important;
    padding-bottom: 64px !important;
  }
  
  .box-padding {
    padding: 24px 20px !important;
  }

  .display-font {
    word-break: break-word;
  }
}

.sidebar-layout {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 96px;
}

@media (max-width: 480px) {
  .wrap { padding: 0 16px; }
  section { padding: 48px 0; }
  h1.display-font { font-size: clamp(32px, 8vw, 42px) !important; }
}

@media (min-width: 901px) {
  .mobile-only {
    display: none !important;
  }
}

.page-container {
  padding-top: 64px;
  padding-bottom: 96px;
}

.box-padding {
  padding: 48px 40px;
}

.form-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.btn-filter { padding: 8px 16px; border-radius: 4px; border: 1px solid var(--line); background: transparent; color: var(--muted); font-weight: 500; font-size: 14px; cursor: pointer; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
.btn-filter:hover { border-color: var(--ink); color: var(--ink); }
.btn-filter.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
